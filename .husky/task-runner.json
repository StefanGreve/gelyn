{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "format",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [ "format", "Gelyn.slnx", "--include", "${staged}" ],
      "include": [ "**/*.cs" ]
    },
    {
      "name": "test",
      "group": "pre-push",
      "command": "dotnet",
      "args": [ "test" ]
    },
    {
      "name": "schema",
      "group": "pre-push",
      "command": "git",
      "args": [ "diff", "--exit-code", "HEAD", "--", "gelyn.schema.json" ]
    },
    {
      "name": "coverage",
      "group": "pre-push",
      "command": "dotnet",
      "args": [
        "tool", "run", "reportgenerator",
        "-reports:TestResults/CoverageReport/coverage.cobertura.xml",
        "-targetdir:TestResults/CoverageReport",
        "-reporttypes:Html",
        "-filefilters:-**/obj/**"
      ]
    }
  ]
}
