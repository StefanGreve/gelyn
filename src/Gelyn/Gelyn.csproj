<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gelyn</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Label="Restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
  </PropertyGroup>

  <PropertyGroup Label="Native AOT">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <OptimizationPreference>Speed</OptimizationPreference>
    <UseSizeOptimizedLinq>false</UseSizeOptimizedLinq>
  </PropertyGroup>

  <PropertyGroup Label="Tool packaging">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gelyn</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64;win-arm64</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <PackageId>Gelyn</PackageId>
    <Description>A simple, cross-platform, and high-performance static site generator for Markdown.</Description>
    <PackageProjectUrl>https://stefangreve.github.io/gelyn/</PackageProjectUrl>
    <PackageTags>dotnet;dotnet-tool;markdown-to-html;ssg;static-site-generator</PackageTags>
    <PackageIcon>gelyn-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/StefanGreve/gelyn</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Label="Themes">
    <ThemeDirectory>$(RepositoryRoot)plugins/gelyn/skills/bootstrap/themes/</ThemeDirectory>
  </PropertyGroup>

  <ItemGroup Label="Themes">
    <EmbeddedResource Include="$(ThemeDirectory)*.css;$(ThemeDirectory)*.js"
                      LogicalName="themes/%(Filename)%(Extension)"
                      Link="themes/%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/gelyn-icon.png" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.TXT" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Packed straight from the compiler package, so the notices always match the runtime compiled into the binary. -->
  <ItemGroup Condition="'$(ILCompilerTargetsPath)' != ''">
    <None Include="$([System.IO.Path]::GetDirectoryName('$(ILCompilerTargetsPath)'))/../THIRD-PARTY-NOTICES.TXT"
          Pack="true"
          PackagePath="/THIRD-PARTY-NOTICES-DOTNET.TXT" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gelyn.Schema" />
    <InternalsVisibleTo Include="Gelyn.Tests" />
  </ItemGroup>

  <ItemGroup Label="Assembly metadata">
    <AssemblyMetadata Include="PackageLicenseExpression" Value="$(PackageLicenseExpression)" />
    <AssemblyMetadata Include="NETCoreSdkVersion" Value="$(NETCoreSdkVersion)" />
  </ItemGroup>

  <!-- SourceLink sets $(SourceRevisionId) in a target, so a static item would read it empty. -->
  <Target Name="StampSourceRevision"
          DependsOnTargets="InitializeSourceControlInformation"
          BeforeTargets="GetAssemblyAttributes">
    <ItemGroup Condition="'$(SourceRevisionId)' != ''">
      <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>

  <Target Name="CleanPublishDirectory" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="SharpYaml" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

</Project>
