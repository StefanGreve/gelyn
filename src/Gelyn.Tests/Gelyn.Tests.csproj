<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)gelyn.schema.json" Link="gelyn.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Gelyn/Gelyn.csproj" />
  </ItemGroup>

  <Target Name="CleanTestResults" AfterTargets="Clean">
    <RemoveDir Directories="$(RepositoryRoot)TestResults" />
  </Target>

</Project>
