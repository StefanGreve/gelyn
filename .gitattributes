# Auto detect text files and perform LF normalization
* text=auto

###############################################################################
# Dotnet
#
# The diff option is needed for earlier builds of msysgit that do not have it
# on by default for csharp files. (Note: This is only used by command line)
###############################################################################
*.cs            text eol=lf diff=csharp
*.cshtml        text eol=lf diff=html
*.csx           text eol=lf diff=csharp
*.slnx          text eol=lf
*.csproj        text eol=lf
*.props         text eol=lf
*.targets       text eol=lf

###############################################################################
# Text files
###############################################################################
*.config        text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.ini           text eol=lf
*.xml           text eol=lf
*.txt           text eol=lf
*.pem           text eol=lf
*.md            text eol=lf diff=markdown
*.mdx           text eol=lf diff=markdown
.editorconfig   text eol=lf

###############################################################################
# Text files without extensions
###############################################################################
README          text eol=lf
LICENSE         text eol=lf
CHANGELOG       text eol=lf

INSTALL         text eol=lf
COPYRIGHT       text eol=lf
CHANGES         text eol=lf
AUTHORS         text eol=lf
CONTRIBUTING    text eol=lf
COPYING         text eol=lf

###############################################################################
# Text files where line endings should be preserved
###############################################################################
*.patch         -text

###############################################################################
# Scripts
#
# Windows PowerShell 5.1 reads a script without a byte order mark in the legacy
# ANSI code page, so a script with non-ASCII characters needs a UTF-8 BOM to
# run there. UTF-16LE is what its Out-File cmdlet and the '>' operator write by
# default, not what it expects of a script. A file that has to stay UTF-16 in
# the working tree can add 'working-tree-encoding=UTF-16' to its line.
#
# Git converts a file with this attribute to UTF-8 when it is added and stores
# that content in the index. On checkout, Git converts it back to the declared
# encoding.
#
# PowerShell 7 defaults to BOM-less UTF-8, like Unix-like platforms.
###############################################################################
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.sh            text eol=lf

###############################################################################
# Git hooks
#
# Hooks carry no file extension, so none of the rules above match them and they
# fall through to '* text=auto'. A CRLF checkout turns the shebang into
# '#!/bin/sh\r', which sh rejects as a bad interpreter.
###############################################################################
.husky/*        text eol=lf

###############################################################################
# Binaries
###############################################################################
*.dll           binary
*.exe           binary
*.pfx           binary
*.cer           binary

###############################################################################
# Exclude files from exporting
#
# An exported archive carries no '.git' directory, so anything that only works
# inside a working copy is dead weight there.
###############################################################################
.gitattributes  export-ignore
.gitignore      export-ignore
.gitkeep        export-ignore
.husky          export-ignore
