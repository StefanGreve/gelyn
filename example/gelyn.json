{
  "$schema": "../gelyn.schema.json",
  "Title": "Gelyn",
  "Language": "en",
  "Author": "Stefan Greve",
  "Description": "A static site generator that turns a folder of Markdown into a website.",
  "BaseUrl": "https://example.com",
  "EnableFeed": true,
  "EnableSitemap": true,
  "FooterLinks": [
    {
      "Label": "GitHub",
      "Url": "https://github.com/StefanGreve/gelyn"
    },
    {
      "Label": "Documentation",
      "Url": "https://stefangreve.github.io/gelyn/"
    }
  ],
  "KaTeXVersion": "0.19.0",
  "MermaidVersion": "12.1.0",
  "ShikiVersion": "4.6.0",
  "ContentDirectory": "example",
  "OutputDirectory": "_site",
  "ExcludePatterns": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    ".DS_Store",
    "Thumbs.db",
    "*~",
    "*.swp",
    "*.orig",
    "*.html",
    "gelyn.json"
  ]
}
