{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gelyn build",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Gelyn/bin/Debug/net10.0/gelyn.dll",
      "args": [
        "build",
        "--config",
        "example/gelyn.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
