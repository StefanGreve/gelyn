{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gelyn build",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Gelyn/bin/Debug/net10.0/gelyn.dll",
      "args": [
        "build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}
