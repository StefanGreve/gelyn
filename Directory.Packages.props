<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Build">
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="SharpYaml" Version="3.17.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="Testably.Abstractions" Version="11.1.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testably.Abstractions.Testing" Version="8.1.1" />
    <PackageVersion Include="TngTech.ArchUnitNET.TUnit" Version="0.13.5" />
    <PackageVersion Include="TUnit" Version="1.85.0" />
  </ItemGroup>
</Project>