<Project>

  <!-- Imported after the project body and after package targets, so a project cannot opt out of these -->
  <PropertyGroup Label="Analyzers">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- IDE0130 reads both properties, which only Visual Studio passes to the analyzers on its own -->
  <ItemGroup Label="Analyzers">
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <PropertyGroup Label="Analyzers" Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="PatchAssemblyVersion" AfterTargets="MinVer" Condition="'$(MinVerMajor)' != ''">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).0.0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <Target Name="CleanRepositoryOutput" AfterTargets="Clean">
    <RemoveDir Directories="$(RepositoryRoot)_docs;
                            $(RepositoryRoot)_site;
                            $(RepositoryRoot)artifacts;
                            $(RepositoryRoot)TestResults" />
  </Target>

</Project>
