<Project>

  <!-- Imported after the project body and after package targets, so a project cannot opt out of these -->
  <PropertyGroup Label="Analyzers">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers" Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="PatchAssemblyVersion" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).0.0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <Target Name="CleanRepositoryOutput" AfterTargets="Clean">
    <RemoveDir Directories="$(RepositoryRoot)_site;$(RepositoryRoot)artifacts;$(RepositoryRoot)TestResults" />
  </Target>

</Project>
